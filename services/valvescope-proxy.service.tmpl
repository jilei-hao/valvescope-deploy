[Unit]
Description=ValveScope reverse proxy (one http origin for manager, viewer, gateway)
After=network.target
PartOf=valvescope.target

[Service]
Type=simple
User=@VS_USER@
Group=@VS_USER@
ExecStart=@VS_CADDY_BIN@ run --config @VS_RENDERED_DIR@/Caddyfile --adapter caddyfile
ExecReload=@VS_CADDY_BIN@ reload --config @VS_RENDERED_DIR@/Caddyfile --adapter caddyfile
# Lets a non-root user listen on a port below 1024 (e.g. 80).
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5

[Install]
WantedBy=valvescope.target
