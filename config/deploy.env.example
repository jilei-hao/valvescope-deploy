# deploy.env — the single source of truth for one ValveScope deployment.
#
# Copy to config/deploy.env (gitignored, mode 600) and edit. Nothing else on the
# server is edited by hand: config/render.sh turns this file into every service's
# .env, the systemd units and the proxy config.
#
# Plain KEY=value lines only (the file is sourced by bash). No spaces around "=".
# Values set to CHANGE_ME are secrets: install/gen-secrets.sh fills them in.

# --- Where clients reach the system -----------------------------------------
# The name or address people type in a browser and the iPad uses. Never
# "localhost": the web viewer bakes this in at build time, and "localhost" makes
# each person's browser talk to their own machine. Today the box is a DHCP lease;
# switch to a hostname once the lab network gives it one (WS-3).
VS_HOST=10.150.12.82
# The only port open on the LAN. Everything is served from http://VS_HOST:VS_PUBLIC_PORT
VS_PUBLIC_PORT=80

# The lab network, for the firewall rule that opens VS_PUBLIC_PORT (ufw). Empty =
# the rule allows any source address. install.sh prints the rule; it applies it only
# when asked (--apply-firewall).
VS_LAN_CIDR=10.150.12.0/23

# --- Unix user and directories ----------------------------------------------
# A dedicated user, not the developer's account.
VS_USER=valvescope
# Holds the deploy repo, fetched sources ($VS_HOME/src) and the conda install.
VS_HOME=/opt/valvescope
# Records what is really deployed (deployed.lock). Written by upgrade.sh only.
VS_STATE_DIR=/opt/valvescope/state
# Blob store (study images, meshes, results). Back this up.
VS_DATA_ROOT=/srv/valvescope/data
# Worker scratch space. Not backed up; safe to empty when the worker is stopped.
VS_WORK_DIR=/srv/valvescope/work
# Gateway upload staging.
VS_UPLOAD_CACHE=/srv/valvescope/upload-cache
# Where backup.sh writes. Meant to be a mount of the lab NAS; a directory on the
# same disk as the data (as on Ludwig today, /srv/valvescope/backup) only protects
# against a bad migration, not against losing the disk.
VS_BACKUP_DIR=/mnt/lab-nas/valvescope-backup

# --- Internal ports (loopback only; the proxy is the only thing on the LAN) --
# Must differ from the dev checkout's 3000 / 8000 / 5173. render.sh refuses those.
VS_GATEWAY_PORT=3100
VS_MANAGER_PORT=8100
VS_VIEWER_PORT=5273

# --- Postgres ----------------------------------------------------------------
# Same cluster as the dev checkout is fine; the database and role names must be
# different. render.sh refuses avrpdb / avrpdsdb.
VS_PG_HOST=127.0.0.1
VS_PG_PORT=5432
VS_DB_NAME=vsdb
VS_DS_DB_NAME=vsdsdb
VS_DB_USER=valvescope
VS_DB_PASSWORD=CHANGE_ME

# --- Gateway -----------------------------------------------------------------
# Signs login tokens (JWT). Changing it logs everyone out.
VS_JWT_SECRET=CHANGE_ME

# --- Worker (avrp-handler) ---------------------------------------------------
# The gateway account the worker logs in with. People get their own accounts.
VS_WORKER_USER=vsworker
VS_WORKER_PASSWORD=CHANGE_ME
# Pipeline modules the worker runs: every module the pinned worker and gateway
# know (scripts/check-modules.sh verifies both sides). A study only shows as
# finished when all of them completed.
VS_MODULE_LIST=phase-detection,auto-segmentation,study-generator,global-measurements,root-strain,root-diameter,tp-measurements
# The deployment's own conda install, separate from the developer's.
VS_CONDA_ROOT=/opt/valvescope/miniconda3
VS_HANDLER_ENV=segflow4d
VS_AUTOSEG_ENV=avrp-auto-seg
# nnU-Net model weights (large; copied to the box once, not in git).
VS_CT_MODELS_DIR=/srv/valvescope/models/ct-model/models
VS_TEE_MODELS_DIR=/srv/valvescope/models/tee-model/models
# 0 = one fold (fast). Unset in the handler means a 5-fold ensemble, ~5x slower.
VS_AUTOSEG_FOLDS=0
# Registration crop padding in voxels. 16 is what an 8 GB GPU needs for 4D CT;
# 0 switches cropping off (only for a GPU that fits a whole chest volume).
VS_STUDYGEN_ROI_CROP_PADDING=16

# --- Network -------------------------------------------------------------------
# CA bundle handed to pip / conda / npm while installing. The lab firewall re-signs
# TLS for some download hosts (download.pytorch.org) with a site CA that only the
# system store knows. Leave empty on a network that does not do this.
VS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# --- Tool paths --------------------------------------------------------------
# Node for the gateway, the manager and the builds. Under $VS_HOME it is installed by
# install.sh (pinned version, checksum verified). A system node works too, if the
# deploy user can run it — on Ludwig /usr/bin/node is a link into the developer's
# home directory, which that user cannot enter.
VS_NODE_BIN=/opt/valvescope/node/bin/node
VS_CADDY_BIN=/usr/bin/caddy
